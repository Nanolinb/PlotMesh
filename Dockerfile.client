# Dockerfile.client · PlotMesh client (Vite + nginx)
# ----------------------------------------------------------------
# 多阶段构建：
#   1. build：用 Node 22 跑 vite build → /app/dist 是静态资源
#   2. nginx：alpine + nginx 当静态服务器
#
# 关键点：
#   - 客户端代码里硬编码 http://localhost:3001/...，部署到 NAS 时
#     需要在容器外用反向代理把 /api 转发到 server 容器（见 nginx.conf）
#   - 也可以在 build 时用 VITE_API_BASE 改地址（v1.6.2 起前端尚未参数化，
#     这里先以 nginx 反代为主）
#
# 端口：80（默认），用 docker-compose 映射到宿主机 5173 / 8080 等

FROM node:22-alpine AS build

WORKDIR /app

# 拷依赖文件先（缓存友好）
COPY client/package.json client/package-lock.json* ./
RUN npm install --no-audit --no-fund

# 拷源码并构建
COPY client/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

# 自定义 nginx 配置：把 /api/* 反代到 server:3001
COPY <<'NGINX_CONF' /etc/nginx/conf.d/default.conf
server {
  listen 80;
  server_name _;

  # 静态资源
  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback
  location / {
    try_files $uri /index.html;
  }

  # 反代 API 到 server 容器（docker-compose 里的服务名）
  location /api/ {
    proxy_pass http://server:3001;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 600s;
  }

  # 反代健康检查
  location = /health {
    proxy_pass http://server:3001/health;
  }

  # 反代上传文件下载
  location /uploads/ {
    proxy_pass http://server:3001;
  }

  # 静态资源 cache
  location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
    expires 1d;
    add_header Cache-Control "public, no-transform";
  }
}
NGINX_CONF

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null || exit 1
