# 大模型 API Key 配置（按需填写）
# 不需要的模型可以不填，节点中不可选择未配置的模型

# 浑元（腾讯混元）
HUNYUAN_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 智谱 GLM
GLM_API_KEY=

# OpenAI GPT
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# ─── 外部 AI 操作画布（v1.6.x）─────────────────────────────────
# /api/canvas/* 的鉴权 token。
#   - 不设：server 启动时自动生成，并持久化到 ~/.plotmesh/api-token，重启不丢
#   - 设了：以本变量为准（优先级最高），重启不变；前端的"重置 token"会被禁用
# 前端侧栏 "🔑 外部 AI 接入" 面板可查看/复制/重置当前 token
PLOTMESH_API_TOKEN=

# 是否对 localhost 也强制鉴权（默认 false，方便 dev 用 curl 调试）
# PLOTMESH_API_REQUIRE_TOKEN_LOCALHOST=false

# 数据目录覆盖：默认 ~/.plotmesh/，可指向 iCloud/Dropbox 同步盘
# PLOTMESH_DATA_DIR=
