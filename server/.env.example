# 大模型 API Key 配置（按需填写）
# 不需要的模型可以不填，节点中不可选择未配置的模型

# 浑元（腾讯混元）
HUNYUAN_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 智谱 GLM
GLM_API_KEY=

# OpenAI GPT / 图片AI（图片AI默认复用同一 Key）
OPENAI_API_KEY=
# 图片AI默认 gpt-image-1；兼容代理可覆盖以下两项
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Kimi / Moonshot（文本AI和图片AI共用）
MOONSHOT_API_KEY=
KIMI_IMAGE_MODEL=kimi-k3
# 如果账号使用国际站或自定义图片输出网关，可覆盖完整 chat/completions 地址：
# KIMI_IMAGE_API_URL=https://api.moonshot.cn/v1/chat/completions

# 通义千问
DASHSCOPE_API_KEY=

# ─── 外部 AI 操作画布（v1.6.x）─────────────────────────────────
# /api/canvas/* 的鉴权 token。
#   - 不设：server 启动时自动生成，并持久化到 ~/.plotmesh/api-token，重启不丢
#   - 设了：以本变量为准（优先级最高），重启不变；前端的"重置 token"会被禁用
# 前端侧栏 "🔑 外部 AI 接入" 面板可查看/复制/重置当前 token
PLOTMESH_API_TOKEN=

# 是否对 localhost 也强制鉴权（默认 false，方便 dev 用 curl 调试）
# PLOTMESH_API_REQUIRE_TOKEN_LOCALHOST=false

# 数据目录覆盖：默认 ~/.plotmesh/，可指向 iCloud/Dropbox 同步盘
# PLOTMESH_DATA_DIR=
