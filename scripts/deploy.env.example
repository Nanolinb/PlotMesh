# scripts/deploy.env.example · NAS 部署配置模板（v1.6.4+）
# ----------------------------------------------------------------
# 复制为 scripts/deploy.env 后填入真实值。
# deploy.env 已被 .gitignore 排除，不会推送到 GitHub。
#
# 用法：
#   cp scripts/deploy.env.example scripts/deploy.env
#   nano scripts/deploy.env       # 填入下面的值
#   bash scripts/deploy-to-nas.sh

# ─── 必填 ──────────────────────────────────────────────────

# NAS / Linux 服务器的 IP 或域名
NAS_HOST=192.168.1.100

# SSH 用户名（群晖通常是 admin 或你创建的用户）
NAS_USER=admin

# SSH 端口（群晖默认 22，自定义过的话改这里）
NAS_PORT=22

# 项目在 NAS 上的部署路径
# 群晖建议放在 /volume1/docker/ 下，方便 Container Manager 看到
NAS_DEPLOY_PATH=/volume1/docker/plotmesh

# ─── 可选 ──────────────────────────────────────────────────

# Git 仓库地址（默认从 GitHub 拉）
# 私有仓库可以用 git@github.com:Nanolinb/PlotMesh.git（需要 NAS 上配 ssh key）
GIT_REPO=https://github.com/Nanolinb/PlotMesh.git

# 部署的 git 分支（默认 main，想跑特定 tag 可改成 v1.6.4 之类）
GIT_BRANCH=main
