# PlotMesh 群晖生产环境变量
# 复制为 .env 后填写。不要将 .env 提交到 Git 或发到群聊。

# 局域网入口端口：最终访问 http://10.118.118.10:18180
PLOTMESH_HTTP_PORT=18180

# 可选：每日 AI PM 摘要执行的小时（群晖时区已在 compose 中设为 Asia/Shanghai）
PLOTMESH_PM_DIGEST_HOUR=9

# ── 按实际使用的模型填写；不使用就保持空白 ──────────────────────
HUNYUAN_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
KIMI_IMAGE_MODEL=kimi-k3
# KIMI_IMAGE_API_URL=https://api.moonshot.cn/v1/chat/completions
DASHSCOPE_API_KEY=

# 可选：固定外部 AI / MCP 使用的 server-level token。
# 不填时，首次启动会自动生成并持久化到 ./data/api-token；管理员可在系统设置中查看或重置。
# PLOTMESH_API_TOKEN=

# 可选：固定 JWT 签名密钥。通常不需要填；不填会在 ./data/jwt-secret 自动生成并持久化。
# PLOTMESH_JWT_SECRET=
